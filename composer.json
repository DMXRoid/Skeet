{
    "name": "schiros/skeet",
    "description": "Skeet — a lightweight PHP ORM and request-handling framework (PHP 8.x refresh).",
    "type": "library",
    "license": "BSD-2-Clause",
    "authors": [
        {
            "name": "Matthew Schiros"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "suggest": {
        "aws/aws-sdk-php": "For AwsSecretsManagerProvider (AWS Secrets Manager)",
        "google/cloud-secret-manager": "For GcpSecretManagerProvider (GCP Secret Manager)",
        "psr/http-client-implementation": "For VaultSecretProvider (any PSR-18 HTTP client)",
        "psr/http-factory-implementation": "For VaultSecretProvider (any PSR-17 request factory)"
    },
    "autoload-dev": {
        "psr-4": {
            "Skeet\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
